{
  "name": "car-league",
  "version": "1.0.0",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "check": "biome check --write .",
    "build": "pnpm -r build",
    "dev": "pnpm --filter frontend build && pnpm -r dev",
    "deploy": "pnpm --filter frontend build && celld deploy .",
    "cf-typegen": "wrangler types backend/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.1",
    "wrangler": "^4.151.1"
  }
}
